<?xml version="1.0" encoding="utf-8"?>
<!--
  Play 上架包专用 manifest 覆盖：
  - 删除常驻保活服务 AlarmGuardService（specialUse 长期前台服务是上架审核的高风险项）
  - 保留 FOREGROUND_SERVICE_SPECIAL_USE 权限：响铃服务 RingService 仍需该类型前台化
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name=".service.AlarmGuardService"
            tools:node="remove" />
    </application>
</manifest>
