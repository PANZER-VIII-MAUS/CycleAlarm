<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CycleAlarm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F4F8</item>
    </style>

    <!--
      显式深色启动主题：MainActivity 在 super.onCreate 之前按 App 主题 setTheme，
      避免「系统浅色 + App 强制深色」时启动瞬间闪白。
    -->
    <style name="Theme.CycleAlarm.OpaqueDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#14161A</item>
    </style>
    <style name="Theme.CycleAlarm.Ring" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
    </style>
    <style name="ThemeOverlay.CycleAlarm.TimePicker.Light" parent="android:Theme.Material.Light.Dialog.Alert" />
    <style name="ThemeOverlay.CycleAlarm.TimePicker.Dark" parent="android:Theme.Material.Dialog.Alert" />
</resources>
