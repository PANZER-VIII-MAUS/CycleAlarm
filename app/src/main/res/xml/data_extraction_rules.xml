<?xml version="1.0" encoding="utf-8"?>
<!--
    纯本地应用：不参与系统云备份，也不参与换机迁移（android:allowBackup="false" 的显式声明版）。
    保留此文件是为了在 Android 12+ 上把意图写清楚，并消除 lint 的 DataExtractionRules 建议。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
