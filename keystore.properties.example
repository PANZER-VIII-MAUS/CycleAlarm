# 用法：复制本文件为 keystore.properties 并填写真实值。
# 路径建议使用正斜杠（Windows 也兼容），例如 C:/secure/cycle_alarm.jks
storeFile=C:/secure/cycle_alarm.jks
storePassword=请填写密钥库密码
keyAlias=cycle_alarm
keyPassword=请填写密钥密码

# 说明：
# 1. keystore.properties 已被 .gitignore 排除，不会提交。
# 2. 也可以完全不用这个文件，改用 Android Studio 的
#    Build > Generate Signed Bundle/APK 向导，效果相同。
